          "id": "83763ed2-7102-4f03-bc4a-38d6ac9dd9df",
          "name": "Apache Hudi Run Cleaning",
          "request": {
            "name": "Apache Hudi Run Cleaning",
            "description": {
              "content": "Trigger a cleaning operation on a Hudi table to remove old file versions.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "hoodie",
                "table",
                ":tableName",
                "clean"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "tableName",
                  "description": "(Required) "
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"policy\": \"<string>\",\n  \"retainCommits\": \"<integer>\",\n  \"retainFileVersions\": \"<integer>\",\n  \"triggerStrategy\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "00db9520-3cd8-4cda-b5a2-a0010ff36126",
              "name": "Cleaning completed",
              "originalRequest": {
                "url": {
                  "path": [
                    "v1",
                    "hoodie",
                    "table",
                    ":tableName",
                    "clean"
